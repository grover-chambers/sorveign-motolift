{
  "rewrites": [
    { "source": "/apply", "destination": "/index.html" },
    { "source": "/motorcycles", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/partners", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },
    { "source": "/cookies", "destination": "/pages/cookies.html" },
    { "source": "/bike-details", "destination": "/pages/bike-details.html" }
  ],
  "build": {
    "command": "sed -i 's|__API_URL__|'\"$API_URL\"'|g' index.html pages/bike-details.html pages/apply.html 2>/dev/null; sed -i 's|__API_URL__|'\"$API_URL\"'|g' index.html"
  }
}
